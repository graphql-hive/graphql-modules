{
  "name": "graphql-modules-platform",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare": "husky install",
    "postinstall": "patch-package",
    "ts:check": "tsc --project tsconfig.json --noEmit",
    "ts:check:graphql-16": "tsc --project tsconfig.graphql-16.json --noEmit",
    "ci:lint": "cross-env \"ESLINT_USE_FLAT_CONFIG=false\" eslint \"packages/**/*.{js,jsx,ts,tsx}\" --output-file eslint_report.json --format json",
    "build": "tsc --project tsconfig.json && bob build && node scripts/fix-async-context.js",
    "test": "vitest --run",
    "prerelease": "yarn build",
    "release": "changeset publish",
    "format": "prettier --cache --ignore-path .gitignore --ignore-path .prettierignore --check --write \"packages/**/*.{js,jsx,json,css,md,mdx,ts,tsx}\"",
    "pr": "changeset",
    "lint": "cross-env \"ESLINT_USE_FLAT_CONFIG=false\" eslint \"packages/**/*.{js,jsx,ts,tsx}\"",
    "benchmark:basic": "NODE_ENV=production ts-node --project tsconfig.app.json benchmark/basic.case.ts"
  },
  "devDependencies": {
    "@apollo/federation": "0.38.1",
    "@apollo/server": "5.4.0",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@envelop/core": "6.0.1",
    "@envelop/graphql-modules": "10.0.1",
    "@graphql-tools/merge": "10.0.9",
    "@types/benchmark": "2.1.5",
    "@types/express": "5.0.6",
    "@types/node": "24.12.0",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "apollo-datasource-rest": "3.7.0",
    "apollo-server-express": "3.13.0",
    "artillery": "2.0.34",
    "benchmark": "2.1.4",
    "bob-the-bundler": "1.7.3",
    "chalk": "4.1.2",
    "cross-env": "10.1.0",
    "dataloader": "2.2.3",
    "eslint": "9.39.4",
    "express": "5.2.1",
    "express-graphql": "0.12.0",
    "globby": "16.1.1",
    "graphql": "17.1.0",
    "graphql-16": "npm:graphql@16.15.0",
    "graphql-jit": "^0.8.10",
    "graphql-subscriptions": "3.0.0",
    "graphql-ws": "6.0.7",
    "graphql-yoga": "6.1.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "patch-package": "8.0.1",
    "prettier": "3.8.1",
    "reflect-metadata": "0.2.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.75.0",
    "ws": "8.19.0"
  },
  "resolutions": {
    "rollup": "2.79.2",
    "esbuild": "0.25.5"
  },
  "prettier": {
    "trailingComma": "es5",
    "semi": true,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.{md,mdx}",
        "options": {
          "semi": false,
          "trailingComma": "none",
          "arrowParens": "avoid"
        }
      }
    ]
  },
  "lint-staged": {
    "*.ts": "cross-env \"ESLINT_USE_FLAT_CONFIG=false\" eslint",
    "*{js,json,css,md,ts,tsx}": "prettier --write"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
