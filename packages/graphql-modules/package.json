{
  "name": "graphql-modules",
  "description": "Create reusable, maintainable, testable and extendable GraphQL modules",
  "keywords": [
    "graphql",
    "graphql-modules",
    "server",
    "typescript",
    "the-guild"
  ],
  "repository": {
    "url": "https://github.com/graphql-hive/graphql-modules"
  },
  "version": "3.1.3",
  "author": "Kamil Kisiela",
  "license": "MIT",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./index.d.ts"
    },
    "./*": {
      "require": "./dist/*.js",
      "import": "./dist/*.mjs",
      "types": "./*.d.ts"
    }
  },
  "imports": {
    "#async-context": {
      "node": "./async-context.node.cjs",
      "default": "./async-context.browser.mjs"
    }
  },
  "typings": "dist/index.d.ts",
  "typescript": {
    "definition": "dist/index.d.ts"
  },
  "scripts": {
    "prepack": "bob prepack"
  },
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@graphql-tools/schema": "^11.0.9",
    "@graphql-tools/wrap": "^12.0.0",
    "@graphql-typed-document-node/core": "^3.1.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "buildOptions": {
    "copy": [
      "LICENSE.md",
      "README.md"
    ]
  }
}
